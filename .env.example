# Copy to .env.local and adjust if needed. .env.local is gitignored; this file is not.
#
# Values below are the actual, verified values for the ReCodEx compose deployment
# this app runs alongside (../ReCOdex/.env, ../ReCOdex/docker-compose.yaml) as of
# 2026-08-17 -- see docs/QUESTIONS.md (Q-001, Q-006) for how they were checked.
# Do not replace them with generic placeholders without re-verifying against that
# deployment; ASS-001/ASS-005 in docs/DECISIONS.md record what happened last time
# this was guessed instead of checked.

# Browser-facing. CAS redirect targets, and anything the browser itself talks to.
API_BASE_PUBLIC=http://recodex.local/api/v1

# Server-side fetches (Server Components, Route Handlers, Server Actions).
# This value is for running OUTSIDE docker (`pnpm dev`/`pnpm start` directly on the
# host) -- not on the compose network, so it must use the same reachable URL as
# API_BASE_PUBLIC. When run via `docker compose` (ticket F-004, landed), the
# container is genuinely on the `recodex` network and gets the internal service
# hostname (`http://api:80/v1`) instead -- but that value is set directly in
# ../ReCOdex/docker-compose.yaml's `web-next` service (see DECISIONS.md DEC-028),
# which overrides this file entirely for the containerized case. This file's value
# only matters for bare-host dev.
API_BASE_INTERNAL=http://recodex.local/api/v1

# Monitor WebSocket (evaluation progress), browser-facing, proxied at /ws.
# Scheme matches the deployment's current PROTOCOL (plain http/ws, no TLS yet) --
# flip to wss:// only when the deployment itself gets TLS, not before.
MONITOR_WS_URL=ws://recodex.local/ws

# This app's own listen port INSIDE the container/process -- always 3000, matches
# the Dockerfile's EXPOSE and the compose service's container-side port mapping.
# The HOST-side port when run via `docker compose` is a separate concern
# (WEB_NEXT_PORT in ../ReCOdex/.env, currently 3001 -- 3000 was already taken by
# something else on the host, see PROGRESS.md F-004). Q-005 resolved.
PORT=3000

# Cookie name prefix for the auth cookie (brief §4 PERSISTENT_TOKENS_KEY_PREFIX
# equivalent) -- kept configurable so two instances of this app could share a
# domain without cookie collisions, per the brief.
SESSION_COOKIE_PREFIX=recodex

# Next's basePath, resolved at BUILD time not runtime (brief §4 URL_PATH_PREFIX
# equivalent). Leave empty unless this app is hosted under a path prefix.
URL_PATH_PREFIX=

# Support contact shown on the external-login failure page (legacy env.json.example's
# EXTERNAL_AUTH_HELPDESK_URL, e.g. "mailto:cas@example.org"). Empty here because this
# deployment has no EXTERNAL_AUTH_* configured at all (verified against ../ReCOdex/.env,
# see docs/QUESTIONS.md Q-004) -- the external-auth callback route (F-019) is built for
# parity but is unreachable/unconfigured in this environment, same as local registration.
EXTERNAL_AUTH_HELPDESK_URL=

# Signing in through somebody else's identity provider (A-007). The sign-in page offers the button
# only when BOTH of the first two are set, which is the legacy app's own condition.
#
#   EXTERNAL_AUTH_URL         where to send the browser. Used exactly as written -- nothing is
#                             appended, because where the provider returns to is the provider's
#                             configuration, not this app's. It must come back to
#                             /api/auth/external/<EXTERNAL_AUTH_SERVICE_ID>/callback?token=<JWT>.
#   EXTERNAL_AUTH_SERVICE_ID  core-api's `authenticatorName`. It has to match both the callback
#                             path above and the name core-api knows the shared JWT secret under,
#                             or the returned token cannot be verified.
#   EXTERNAL_AUTH_NAME        what to call it on the button ("CAS UK"). Falls back to the service
#                             id, which is ugly but never wrong.
#
# All empty here: this deployment configures no external authenticator at all (Q-004), so the
# button does not appear and the flow cannot be exercised end to end.
EXTERNAL_AUTH_URL=
EXTERNAL_AUTH_SERVICE_ID=
EXTERNAL_AUTH_NAME=

# Whether people may create their own accounts (A-003). core-api has the same switch
# (`localRegistration.enabled`, the compose repo's LOCAL_REGISTRATION_ENABLED) and publishes no way
# to ask about it, so this app has to be told separately -- the legacy frontend carries the same
# variable for the same reason. Off unless set to "true": on an instance that authenticates through
# CAS, a registration form is not merely useless but misleading.
ALLOW_LOCAL_REGISTRATION=false

# Minutes a "short session" lasts, when this deployment offers one (A-002). The legacy frontend's
# SHORT_SESSION, in the same unit. Unset means the sign-in form does not offer the choice.
SHORT_SESSION_MINUTES=
