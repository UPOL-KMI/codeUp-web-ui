# Copy to .env.local and adjust if needed. .env.local is gitignored; this file is not.
#
# Values below are the actual, verified values for the ReCodEx compose deployment
# this app runs alongside (../ReCOdex/.env, ../ReCOdex/docker-compose.yaml) as of
# 2026-08-17 -- see docs/QUESTIONS.md (Q-001, Q-006) for how they were checked.
# Do not replace them with generic placeholders without re-verifying against that
# deployment; ASS-001/ASS-005 in docs/DECISIONS.md record what happened last time
# this was guessed instead of checked.

# Browser-facing. CAS redirect targets, and anything the browser itself talks to.
API_BASE_PUBLIC=http://recodex.local/api/v1

# Server-side fetches (Server Components, Route Handlers, Server Actions).
# While this app runs outside docker (`pnpm dev`/`pnpm start` on the host, current
# setup), it is NOT on the compose network and must use the same reachable URL as
# API_BASE_PUBLIC. Once this app gets its own compose service entry (ticket F-004,
# constraint-1 diff/approval required), change this to the internal service
# hostname (`http://api:80/v1`) to skip the extra proxy hop -- the two variables
# exist precisely so that change is a one-line env edit, not a code change.
API_BASE_INTERNAL=http://recodex.local/api/v1

# Monitor WebSocket (evaluation progress), browser-facing, proxied at /ws.
# Scheme matches the deployment's current PROTOCOL (plain http/ws, no TLS yet) --
# flip to wss:// only when the deployment itself gets TLS, not before.
MONITOR_WS_URL=ws://recodex.local/ws

# This app's own port. 3000 is unclaimed in the current deployment (api/web-app/
# monitor/mysql/broker are all internal-only or on different ports, only the nginx
# proxy publishes 80) -- open question Q-005 in docs/QUESTIONS.md, no operator
# preference given yet, revisit if it ever collides with something.
PORT=3000

# Cookie name prefix for the auth cookie (brief §4 PERSISTENT_TOKENS_KEY_PREFIX
# equivalent) -- kept configurable so two instances of this app could share a
# domain without cookie collisions, per the brief.
SESSION_COOKIE_PREFIX=recodex

# Next's basePath, resolved at BUILD time not runtime (brief §4 URL_PATH_PREFIX
# equivalent). Leave empty unless this app is hosted under a path prefix.
URL_PATH_PREFIX=
